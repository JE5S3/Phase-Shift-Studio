{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    { "source": "/admin", "destination": "https://phase-shift-cms.vercel.app/", "permanent": false },
    { "source": "/admin/", "destination": "https://phase-shift-cms.vercel.app/", "permanent": false },
    { "source": "/admin/index.html", "destination": "https://phase-shift-cms.vercel.app/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/content-data.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/cms-manifest.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/cms-runtime.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}

